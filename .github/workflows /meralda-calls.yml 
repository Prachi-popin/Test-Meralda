name: Meralda Video call
description: Run tests for Meralda Video call with CodePush on macOS

on:
  workflow_dispatch:
    inputs:
      source:
        description: 'Trigger source'
        required: false
        default: 'PopinFrontend'
  push:
    branches: [ MySecondBranch ]
  pull_request:
    branches: [ MySecondBranch]

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Install Firefox
        run: |
          brew install --cask firefox

      - name: Run tests
        run: mvn clean test
